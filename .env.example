# Google OAuth2 credentials
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Sync interval in minutes
SYNC_INTERVAL=5

# Server port
PORT=3001

# HTTPS (mkcert): paths to your key and cert to serve over TLS.
# Required for the battery indicator, offline mode, and Google OAuth.
# With Docker, certs are mounted at /certs inside the container, so use
# paths like /certs/key.pem and /certs/cert.pem. Leave empty for plain HTTP.
HTTPS_KEY=/certs/key.pem
HTTPS_CERT=/certs/cert.pem

# Comma-separated list of calendar IDs to sync (leave empty for primary)
CALENDAR_IDS=primary

# Comma-separated list of Google Task list IDs to sync (leave empty for all)
TASK_LIST_IDS=
